{
  "name": "@nexus/controller",
  "description": "Nexus live Controller panel: read-only controller-state adapter (host route) and the right-side Controller panel for the DeepSeek Harness Web GUI (client slot entry).",
  "version": "1.0.0",
  "publishConfig": {
    "access": "restricted"
  },
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./status": {
      "default": "./lib/status.cjs"
    },
    "./detail": {
      "default": "./lib/detail.cjs"
    },
    "./gate": {
      "default": "./lib/gate.cjs"
    },
    "./registry": {
      "default": "./lib/registry.cjs"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "license": "UNLICENSED",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/status.cjs",
    "lib/detail.cjs",
    "lib/gate.cjs",
    "lib/registry.cjs"
  ]
}
