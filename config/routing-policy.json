{
  "version": 2,
  "defaultPreset": "aih-engineering",
  "defaultExecutionClass": "deepseek_normal",
  "presets": {
    "aih-engineering": {
      "displayName": "Normal Engineering",
      "allowOpenAI": true,
      "allowCodexSubagent": true,
      "failurePolicy": "bounded-escalation",
      "rootExecutor": { "name": "DeepSeek V4 Flash MAX", "provider": "flash-max-direct", "model": "deepseek-v4-flash", "reasoning": "max" },
      "tiers": {
        "1": { "name": "Codex manual review (deprecated tier1)", "provider": "sol-local", "model": "gpt-5.6-sol", "reasoning": "medium" },
        "2": { "name": "DeepSeek deep (deprecated tier2)", "provider": "flash-max-direct", "model": "deepseek-v4-flash", "reasoning": "max" },
        "3": { "name": "DeepSeek normal (deprecated tier3)", "provider": "flash-high-direct", "model": "deepseek-v4-flash", "reasoning": "high" }
      }
    },
    "aih-deepseek": {
      "displayName": "DeepSeek Only",
      "allowOpenAI": false,
      "allowCodexSubagent": false,
      "failurePolicy": "fail-closed",
      "rootExecutor": { "name": "DeepSeek V4 Flash MAX", "provider": "flash-max-direct", "model": "deepseek-v4-flash", "reasoning": "max" },
      "tiers": {
        "1": { "name": "DeepSeek deep (deprecated tier1)", "provider": "flash-max-direct", "model": "deepseek-v4-flash", "reasoning": "max" },
        "2": { "name": "DeepSeek deep (deprecated tier2)", "provider": "flash-max-direct", "model": "deepseek-v4-flash", "reasoning": "max" },
        "3": { "name": "DeepSeek normal (deprecated tier3)", "provider": "flash-high-direct", "model": "deepseek-v4-flash", "reasoning": "high" }
      }
    }
  },
  "executionClasses": {
    "deterministic": { "provider": null, "model": null, "reasoning": null, "writable": false },
    "deepseek_normal": { "provider": "flash-high-direct", "model": "deepseek-v4-flash", "reasoning": "high", "writable": true },
    "deepseek_deep": { "provider": "flash-max-direct", "model": "deepseek-v4-flash", "reasoning": "max", "writable": true },
    "codex_review": { "provider": "sol-local", "model": "gpt-5.6-sol", "reasoning": "medium", "writable": false },
    "codex_solve": { "provider": "sol-local", "model": "gpt-5.6-sol", "reasoning": "high", "writable": true, "requiresUserApproval": true }
  },
  "legacyTierMap": { "tier3": "deepseek_normal", "tier2": "deepseek_deep", "tier1": "codex_review" },
  "initialRules": [
    { "id": "critical-boundary", "executionClass": "deepseek_deep", "risk": "critical", "reviewRequired": true, "reason": "Critical security, concurrency, migration, authentication, or permission boundaries start with deeper DeepSeek work and require bounded review.", "patterns": ["\\b(auth|authentication|authorization|permission architecture|credential boundary|security boundary|cryptograph|encryption|database migration|migration safety|concurrency correctness)\\b"] },
    { "id": "mechanical-deterministic", "executionClass": "deterministic", "risk": "low", "reviewRequired": false, "reason": "A purely mechanical fact or verification operation needs no model.", "patterns": ["^(run|show|list|check|verify)\\s+(tests?|lint|typecheck|build|status|diff)(\\s|$)"] }
  ],
  "escalation": {
    "sameFailureThreshold": 2,
    "immediateReviewSignals": ["critical-security-boundary", "concurrency-uncertainty", "migration-safety", "auth-permission-architecture", "user-codex"],
    "nonEscalatingSignals": ["none", "progress", "minor-error", "attempt-failure", "verification-failure"]
  },
  "codex": {
    "automaticReview": { "maxCallsPerTask": 1, "maxFiles": 8, "maxDiffLines": 2500, "maxContextTokens": 30000, "maxOutputTokens": 2500 },
    "writable": { "default": false },
    "fullRepo": { "default": false, "requiresUserApproval": true }
  }
}
