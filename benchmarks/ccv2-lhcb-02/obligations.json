      "grader": "behavior:identifier-roundtrip",
      "status": "design"
    },
    {
      "id": "quarantine-original",
      "introducedBy": "E10",
      "category": "forbidden",
      "critical": false,
      "rule": "Quarantined original segments are retained.",
      "grader": "behavior:quarantine-original",
      "status": "design"
    },
    {
      "id": "available-balance",
      "introducedBy": "E12",
      "category": "implementation",
      "critical": false,
      "rule": "Reservations reduce spendable balance but not total balance.",
      "grader": "behavior:available-balance",
      "status": "design"
    },
    {
      "id": "retry-taxonomy",
      "introducedBy": "E14",
      "category": "recovery",
      "critical": false,
      "rule": "Retry only classified transient failures with bounded attempts.",
      "grader": "behavior:retry-taxonomy",
      "status": "design"
    },
    {
      "id": "grant-revocation",
      "introducedBy": "E15",
      "category": "security",
      "critical": true,
      "rule": "Revoked grants do not authorize cached replays.",
      "grader": "behavior:grant-revocation",
      "status": "design"
    },
    {
      "id": "rollback-readers",
      "introducedBy": "E16",
      "category": "compatibility",
      "critical": false,
      "rule": "Rollback must preserve data required by mixed version readers.",
      "grader": "behavior:rollback-readers",
      "status": "design"
    },
    {
      "id": "service-boundary",
      "introducedBy": "E17",
      "category": "architecture",
      "critical": false,
      "rule": "CLI and API route mutations through the same service.",
      "grader": "behavior:service-boundary",
      "status": "design"
    },
    {
      "id": "export-format",
      "introducedBy": "E19",
      "category": "compatibility",
      "critical": false,
      "rule": "Export keeps consumer contract and opaque identifier encoding.",
      "grader": "behavior:export-format",
      "status": "design"
    },
    {
      "id": "cancel-before-commit",
      "introducedBy": "E21",
      "category": "implementation",
      "critical": false,
      "rule": "Cancellation before commit prevents mutation.",
      "grader": "behavior:cancel-before-commit",
      "status": "design"
    },
    {
      "id": "batch-atomicity",
      "introducedBy": "E23",
      "category": "implementation",
      "critical": false,
      "rule": "Batch commits all validated mutations or none.",
      "grader": "behavior:batch-atomicity",
      "status": "design"
    }
  ],
  "scopeNote": "Calibration probes cover selected early behaviors only; official obligation completeness and T99 safety remain unverified until the final integration grader is implemented."
}
