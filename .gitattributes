* text=auto
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psd1 text eol=crlf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
# POSIX shell scripts must always be LF: they run on Linux and CRLF bytes
# break every interpreter.
*.sh text eol=lf
setup.sh text eol=lf
bin/linux/* text eol=lf
