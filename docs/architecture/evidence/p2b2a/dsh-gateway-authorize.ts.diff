 export default TypertGatewayService
+
+/** One operation presented to `gateway/authorize` listeners (frozen copy). */
+export interface GatewayAuthorizeRequest {
+  readonly principal: Principal
+  /** `<namespace>/<method>`, `$events` or `$events/result`. */
+  readonly action: string
+  /** Attributed resources; `undefined` when the arguments could not be attributed. */
+  readonly resources: readonly RemoteAccessResource[] | undefined
+  readonly args: unknown
+  readonly transport: 'unary' | 'stream'
+}
+
+/** A listener's refusal; abstain by returning `undefined`. */
+export interface GatewayAuthorizeDenial { readonly kind: 'deny'; readonly reason: string }
+
+declare module '@deepseek-ai/cordis' {
+  interface Events {
+    'gateway/authorize'(request: GatewayAuthorizeRequest): GatewayAuthorizeDenial | undefined | Promise<GatewayAuthorizeDenial | undefined>
+  }
+}
+
+function deepFreeze<T>(value: T): T {
+  if (isObject(value) && !Object.isFrozen(value)) {
+    Object.freeze(value)
+    for (const key of Reflect.ownKeys(value)) deepFreeze((value as Record<PropertyKey, unknown>)[key])
+  }
+  return value
+}
