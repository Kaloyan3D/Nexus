{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus",
  "version": "0.1.0",
  "identifier": "ai.arthurlabs.nexus.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Nexus",
        "width": 1672,
        "height": 941,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "backgroundColor": "#09090B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "../../../native/target/release/nexusd": "bin/nexusd",
      "../../../native/target/release/nexus-broker": "bin/nexus-broker",
      "../../../native/target/release/nexus-approver": "bin/nexus-approver",
      "../../../native/target/release/nexus-confine": "bin/nexus-confine",
      "../../../native/target/release/nexus-egress": "bin/nexus-egress",
      "../../../config/registry/*.cjs": "repo/config/registry/",
      "../../../config/registry/modes/*.json": "repo/config/registry/modes/"
    },
    "shortDescription": "Nexus - build and fix software with an AI that shows its work",
    "longDescription": "Nexus runs an AI engineering assistant on your computer. Open a project, describe what to build or fix, and Nexus edits, tests and previews it inside the permissions you give, then shows what actually ran.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "nodejs (>= 18)",
          "zenity | kdialog"
        ],
        "recommends": [
          "xdg-utils",
          "git"
        ]
      }
    }
  }
}
