{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Nexus main window: read-only native client commands, isolated mock execution, and a fail-safe model-run cancel marker only. No fs, shell, http or opener plugins; no credential, grant or issuer access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-info",
    "allow-runtime-status",
    "allow-list-tasks",
    "allow-task-journal",
    "allow-model-catalog",
    "allow-live-blockers",
    "allow-run-mock",
    "allow-conversation-read",
    "allow-model-io-read",
    "allow-list-mock-conversations",
    "allow-list-model-conversations",
    "allow-model-run-status",
    "allow-cancel-model-run",
    "allow-intent-models",
    "allow-intent-targets",
    "allow-intent-result",
    "allow-intent-submit",
    "allow-intent-workspaces",
    "allow-intent-inspect-submit",
    "allow-intent-code-sources",
    "allow-intent-code-limits",
    "allow-intent-code-submit",
    "allow-intent-diff",
    "allow-intent-activity",
    "allow-intent-copy",
    "allow-intent-status",
    "allow-intent-cancel",
    "allow-intent-list",
    "allow-tool-events",
    "allow-list-approvals",
    "allow-integrity-status",
    "allow-runtime-state",
    "allow-runtime-start",
    "allow-provider-connect",
    "allow-provider-consent",
    "allow-provider-revoke",
    "allow-project-pick",
    "allow-project-list",
    "allow-job-list",
    "allow-job-stop",
    "allow-project-refresh",
    "allow-project-set-policy",
    "allow-code-limits-set",
    "allow-project-forget",
    "allow-project-adopt",
    "allow-project-allow-work",
    "allow-project-allow-previews",
    "allow-project-revoke-previews",
    "allow-project-allow-installs",
    "allow-project-use-automatic-approval",
    "allow-job-logs",
    "allow-preview-open",
    "allow-environment-check",
    "allow-exec-effects",
    "allow-exec-restore-preview",
    "allow-exec-restore-apply",
    "allow-run-restore-preview",
    "allow-run-restore-apply",
    "allow-thread-list",
    "allow-thread-get",
    "allow-thread-send",
    "allow-thread-create",
    "allow-thread-update",
    "allow-engine-choice",
    "allow-engine-prefer",
    "allow-adaptive-setup",
    "allow-run-engine",
    "allow-intent-resume",
    "allow-run-resumable",
    "allow-project-set-edit-mode",
    "allow-project-set-grant",
    "allow-project-end-grant"
  ]
}
