# The recommended setup stores this value in data/.credentials.yaml with
# user-only Windows permissions. This file is only a variable-name reference.
DEEPSEEK_API_KEY=
# Meta Model API (Muse Spark) — official Meta key variable. Optional: Nexus
# stays fully usable without it; only the Muse provider becomes unavailable.
MODEL_API_KEY=
# OpenCode Go (Muse Spark 1.3 Contributor over the OpenCode Go Responses
# transport https://opencode.ai/zen/go/v1).
# Optional: only the Muse Spark 1.3 — OpenCode Go profile needs it. The
# credential ALSO lives in data/.credentials.yaml (OPENCODE_API_KEY: <key>)
# via the existing secure provider configuration mechanism; never commit it.
OPENCODE_API_KEY=
