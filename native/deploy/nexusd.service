# nexusd production unit (A4.4, security profile production-v1).
#
# NOT VERIFIED on a real system manager with User=/Group=: the disposable
# systemd test (deploy/systemd-user-integration-test.sh) used a USER manager
# on one UID. See native/A4.4-EVIDENCE.md for exactly what is unverified.
#
# Security properties this unit enforces (root-owned file, so the daemon's
# own user cannot relax them):
#   * --security-profile production-v1: the daemon refuses to start unless
#     the complete contract is present (independent approver, human
#     approval, external witness, kernel resource limits when processes are
#     enabled, no test-only flags/env). It validates before touching state.
#   * Requires=/After= the witness: no witness, no start; witness stop stops
#     the daemon.
#   * No Environment= lines: nothing test-only can be armed from the unit.
#
# Replace the *_HERE tokens at provisioning time. Writes are enabled; add
# --enable-process --require-kernel-resource-limits only on hosts where the
# sandbox preflight with kernel-enforced limits passes.
[Unit]
Description=nexusd native kernel daemon (production-v1)
After=network.target nexus-witness.service
Requires=nexus-witness.service

[Service]
Type=simple
User=nexusd
Group=nexusd
SupplementaryGroups=nexus-issuer nexus-issuercred nexus-approver nexus-witnessc
UMask=0077
RuntimeDirectory=nexusd nexusd-cred nexusd-approver
RuntimeDirectoryMode=0750
StateDirectory=nexusd
StateDirectoryMode=0700
Delegate=yes
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=false
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/nexusd /run/nexusd /run/nexusd-cred /run/nexusd-approver WORKSPACE_BASE_HERE
ExecStartPre=/bin/chgrp nexus-issuer /run/nexusd
ExecStartPre=/bin/chgrp nexus-issuercred /run/nexusd-cred
ExecStartPre=/bin/chgrp nexus-approver /run/nexusd-approver
ExecStartPre=/bin/chmod 0750 /run/nexusd /run/nexusd-cred /run/nexusd-approver
ExecStart=/usr/local/bin/nexusd \
  --security-profile production-v1 \
  --db /var/lib/nexusd/k.db --witness /var/lib/nexusd/k.witness.db \
  --socket /run/nexusd/n.sock --cap /var/lib/nexusd/issuer.cap \
  --trust-mode shadow-test \
  --allowed-uids ISSUER_UID_HERE --socket-group nexus-issuer \
  --cap-handoff /run/nexusd-cred/issuer.handoff --cap-handoff-gid nexus-issuercred \
  --approver-cap /run/nexusd-approver/approver.cap --approver-uids APPROVER_UID_HERE \
  --approver-cap-gid nexus-approver --require-independent-approver \
  --require-human-approval \
  --require-external-witness --external-witness /run/nexus-witness/w.sock \
  --external-witness-uid NEXUS_WITNESS_UID_HERE \
  --workspace-bases WORKSPACE_BASE_HERE --enable-writes
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
