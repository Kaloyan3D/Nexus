+describe("withoutQuery", () => {
+  const tests = [
+    // Single key removal
+    { input: "/foo?bar=1&baz=2", keys: "bar", out: "/foo?baz=2" },
+    { input: "/foo?bar=1&baz=2", keys: "baz", out: "/foo?bar=1" },
+    // Multiple keys
+    {
+      input: "/foo?bar=1&baz=2&qux=3",
+      keys: ["bar", "qux"],
+      out: "/foo?baz=2",
+    },
+    { input: "/foo?bar=1&baz=2", keys: ["bar", "baz"], out: "/foo" },
+    // Last param removed => "?" disappears
+    { input: "/foo?bar=1", keys: "bar", out: "/foo" },
+    { input: "/foo?", keys: "bar", out: "/foo?" },
+    // Key not present => unchanged
+    { input: "/foo?bar=1", keys: "missing", out: "/foo?bar=1" },
+    { input: "/foo?bar=1", keys: ["x", "y"], out: "/foo?bar=1" },
+    // No query at all => unchanged
+    { input: "/foo", keys: "bar", out: "/foo" },
+    { input: "/foo#hash", keys: "bar", out: "/foo#hash" },
+    { input: "", keys: "bar", out: "" },
+    // Repeated keys are all removed
+    { input: "/foo?bar=1&bar=2&baz=3", keys: "bar", out: "/foo?baz=3" },
+    { input: "/foo?bar=1&bar=2", keys: "bar", out: "/foo" },
+    // Empty values
+    { input: "/foo?bar=&baz=2", keys: "bar", out: "/foo?baz=2" },
+    { input: "/foo?bar&baz=2", keys: "bar", out: "/foo?baz=2" },
+    { input: "/foo?bar=", keys: "bar", out: "/foo" },
+    { input: "/foo?bar", keys: "bar", out: "/foo" },
+    // Relative URLs
+    { input: "?bar=1&baz=2", keys: "bar", out: "?baz=2" },
+    { input: "?bar=1", keys: "bar", out: "" },
+    { input: "foo?bar=1&baz=2", keys: "bar", out: "foo?baz=2" },
+    // Hash is preserved
+    { input: "/foo?bar=1&baz=2#hash", keys: "bar", out: "/foo?baz=2#hash" },
+    { input: "/foo?bar=1#hash", keys: "bar", out: "/foo#hash" },
+    { input: "#hash", keys: "bar", out: "#hash" },
+    // Full URLs
+    {
+      input: "https://example.com/foo?bar=1&baz=2#hash",
+      keys: "bar",
+      out: "https://example.com/foo?baz=2#hash",
+    },
+    {
+      input: "https://example.com/foo?bar=1",
+      keys: "bar",
+      out: "https://example.com/foo",
+    },
+    // Order of remaining params is preserved
+    {
+      input: "/foo?c=3&a=1&b=2",
+      keys: "a",
+      out: "/foo?c=3&b=2",
+    },
+    // Encoding of remaining params is preserved
+    {
+      input: "/foo?bar=1&q=hello+world&baz=a%26b",
+      keys: "bar",
+      out: "/foo?q=hello+world&baz=a%26b",
+    },
+    // Keys matched after decoding
+    { input: "/foo?a%20b=1&c=2", keys: "a b", out: "/foo?c=2" },
+    { input: "/foo?a+b=1&c=2", keys: "a b", out: "/foo?c=2" },
+    { input: "/foo?a%20b=1&c=2", keys: "a%20b", out: "/foo?c=2" },
+    // Empty keys array => unchanged
+    { input: "/foo?bar=1", keys: [], out: "/foo?bar=1" },
+    // Values containing "=" are kept intact
+    { input: "/foo?bar=a%3Db&baz=2", keys: "bar", out: "/foo?baz=2" },
+    { input: "/foo?bar=a=b&baz=2", keys: "baz", out: "/foo?bar=a=b" },
+  ];
+
+  for (const t of tests) {
+    test(`${t.input} without ${JSON.stringify(t.keys)}`, () => {
+      expect(withoutQuery(t.input, t.keys)).toBe(t.out);
+    });
+  }
+});
