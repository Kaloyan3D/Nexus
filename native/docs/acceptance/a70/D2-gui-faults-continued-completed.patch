+/**
+ * Removes the given query parameter(s) from the URL.
+ *
+ * Other parameters keep their order and their original encoding.
+ * If no parameters are left, the `?` is removed as well.
+ * Keys are matched after decoding, so an encoded key like `a%20b` matches `a b`.
+ *
+ * @example
+ *
+ * ```js
+ * withoutQuery("/foo?bar=1&baz=2", "bar"); // "/foo?baz=2"
+ * withoutQuery("/foo?bar=1&bar=2&baz=3", "bar"); // "/foo?baz=3"
+ * withoutQuery("/foo?bar=1", "bar"); // "/foo"
+ * ```
+ *
+ * @group utils
+ */
+export function withoutQuery(input: string, keys: string | string[]): string {
+  if (!input.includes("?")) {
+    return input;
+  }
+  const _keys = Array.isArray(keys) ? keys : [keys];
+  if (_keys.length === 0) {
+    return input;
+  }
+  const keysToRemove = new Set(_keys.map((key) => decodeQueryKey(key)));
+  const parsed = parseURL(input);
+  if (!parsed.search || parsed.search === "?") {
+    return input;
+  }
+  const raw = parsed.search.startsWith("?")
+    ? parsed.search.slice(1)
+    : parsed.search;
+  const parts = raw.split("&");
+  const kept = parts.filter((part) => {
+    const eqIndex = part.indexOf("=");
+    const rawKey = eqIndex === -1 ? part : part.slice(0, eqIndex);
+    return !keysToRemove.has(decodeQueryKey(rawKey));
+  });
+  if (kept.length === parts.length) {
+    return input;
+  }
+  parsed.search = kept.length > 0 ? `?${kept.join("&")}` : "";
+  return stringifyParsedURL(parsed);
+}
