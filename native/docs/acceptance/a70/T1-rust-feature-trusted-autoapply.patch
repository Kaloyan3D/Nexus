diff --git a/tests/titles.rs b/tests/titles.rs
new file mode 100644
index 0000000..f3aa328
--- /dev/null
+++ b/tests/titles.rs
@@ -0,0 +1,19 @@
+use taskboard::{Priority, Store};
+
+#[test]
+fn titles_come_back_in_priority_order_high_first_then_title() {
+    let mut s = Store::new();
+    s.add("low one", vec![], Priority::Low);
+    s.add("high b", vec![], Priority::High);
+    s.add("normal one", vec![], Priority::Normal);
+    s.add("high a", vec![], Priority::High);
+    assert_eq!(
+        s.titles(),
+        vec!["high a", "high b", "normal one", "low one"]
+    );
+}
+
+#[test]
+fn titles_of_an_empty_board_is_empty() {
+    assert!(Store::new().titles().is_empty());
+}
