         let mark = if t.status == Status::Done { "x" } else { " " };
-        out.push_str(&format!("[{}] #{} ({}) {}\n", mark, t.id, t.priority.label(), t.title));
+        out.push_str(&format!(
+            "[{}] #{} ({}) {}\n",
+            mark,
+            t.id,
+            t.priority.label(),
+            t.title
+        ));
     }
     out
 }
