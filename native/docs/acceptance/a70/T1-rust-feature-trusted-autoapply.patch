 use crate::model::{Status, Task};
+use std::cmp::Reverse;
 
 /// One line per task, grouped by priority (high first) and then by id:
 /// `[ ] #3 (high) Write docs`   or   `[x] #1 (low) Old thing`
 pub fn render(tasks: &[&Task]) -> String {
     let mut sorted: Vec<&&Task> = tasks.iter().collect();
-    sorted.sort_by_key(|t| (t.priority, t.id));
+    sorted.sort_by_key(|t| (Reverse(t.priority), t.id));
     let mut out = String::new();
