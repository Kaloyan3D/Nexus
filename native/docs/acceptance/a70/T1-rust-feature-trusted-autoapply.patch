@@ -35,6 +55,43 @@ impl Store {
 
     /// Tasks carrying `tag` (case-insensitive).
     pub fn with_tag(&self, tag: &str) -> Vec<&Task> {
-        self.tasks.iter().filter(|t| t.tags.iter().any(|x| x == tag)).collect()
+        let needle = tag.to_lowercase();
+        self.tasks
+            .iter()
+            .filter(|t| t.tags.iter().any(|x| x.to_lowercase() == needle))
+            .collect()
+    }
+
+    /// Counts per status and per priority.
+    pub fn stats(&self) -> Stats {
+        let mut st = Stats::default();
+        for t in &self.tasks {
+            match t.status {
+                Status::Open => st.open += 1,
+                Status::Done => st.done += 1,
+            }
+            match t.priority {
+                Priority::High => st.high += 1,
+                Priority::Normal => st.normal += 1,
+                Priority::Low => st.low += 1,
+            }
+        }
+        st
+    }
+
+    /// Tasks ordered by priority (high first), then by title.
+    pub fn sorted_by_priority(&self) -> Vec<&Task> {
+        let mut v: Vec<&Task> = self.tasks.iter().collect();
+        v.sort_by_key(|t| (Reverse(t.priority), t.title.clone()));
+        v
+    }
+
+    /// All task titles in priority order (high first, then title),
+    /// so callers do not need to call `sorted_by_priority` by hand.
+    pub fn titles(&self) -> Vec<String> {
+        self.sorted_by_priority()
+            .iter()
+            .map(|t| t.title.clone())
+            .collect()
     }
 }
