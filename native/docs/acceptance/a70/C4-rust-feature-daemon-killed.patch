diff --git a/src/store.rs.new b/src/store.rs.new
new file mode 100644
index 0000000..5df1433
--- /dev/null
+++ b/src/store.rs.new
@@ -0,0 +1,83 @@
+use crate::model::{Priority, Status, Task};
+
+#[derive(Debug, Default)]
+pub struct Store {
+    tasks: Vec<Task>,
+    next_id: u32,
+}
+
+/// Counts of tasks per status and per priority.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub struct Stats {
+    pub open: usize,
+    pub done: usize,
+    pub high: usize,
+    pub normal: usize,
+    pub low: usize,
+}
+
+impl Store {
+    pub fn new() -> Store {
+        Store { tasks: Vec::new(), next_id: 1 }
+    }
+
+    /// Add a task; ids start at 1.
+    pub fn add(&mut self, title: &str, tags: Vec<String>, priority: Priority) -> u32 {
+        let id = self.next_id;
+        self.next_id += 1;
+        self.tasks.push(Task { id, title: title.to_string(), tags, priority, status: Status::Open });
+        id
+    }
+
+    pub fn complete(&mut self, id: u32) -> bool {
+        match self.tasks.iter_mut().find(|t| t.id == id) {
+            Some(t) => {
+                t.status = Status::Done;
+                true
+            }
+            None => false,
+        }
+    }
+
+    pub fn all(&self) -> &[Task] {
+        &self.tasks
+    }
+
+    /// Tasks carrying `tag` (case-insensitive).
+    pub fn with_tag(&self, tag: &str) -> Vec<&Task> {
+        let needle = tag.to_lowercase();
+        self.tasks
+            .iter()
+            .filter(|t| t.tags.iter().any(|x| x.to_lowercase() == needle))
+            .collect()
+    }
+
+    /// Tasks sorted by priority (high first) and then by title.
+    pub fn sorted_by_priority(&self) -> Vec<&Task> {
+        let mut out: Vec<&Task> = self.tasks.iter().collect();
+        out.sort_by(|a, b| {
+            a.priority
+                .rank()
+                .cmp(&b.priority.rank())
+                .then_with(|| a.title.cmp(&b.title))
+        });
+        out
+    }
+
+    /// Counts per status and per priority.
+    pub fn stats(&self) -> Stats {
+        let mut st = Stats::default();
+        for t in &self.tasks {
+            match t.status {
+                Status::Open => st.open += 1,
+                Status::Done => st.done += 1,
+            }
+            match t.priority {
+                Priority::High => st.high += 1,
+                Priority::Normal => st.normal += 1,
+                Priority::Low => st.low += 1,
+            }
+        }
+        st
+    }
+}
diff --git a/tests/priority.rs b/tests/priority.rs
new file mode 100644
index 0000000..f389608
--- /dev/null
+++ b/tests/priority.rs
@@ -0,0 +1,47 @@
+use taskboard::{report::render, Priority, Store};
+
+#[test]
+fn sorted_by_priority_orders_high_first_then_title() {
+    let mut s = Store::new();
+    s.add("delta", vec![], Priority::Low);
+    s.add("bravo", vec![], Priority::High);
+    s.add("alpha", vec![], Priority::High);
+    s.add("charlie", vec![], Priority::Normal);
+    let titles: Vec<&str> = s.sorted_by_priority().iter().map(|t| t.title.as_str()).collect();
+    assert_eq!(titles, vec!["alpha", "bravo", "charlie", "delta"]);
+}
+
+#[test]
+fn sorted_by_priority_on_empty_store_is_empty() {
+    assert!(Store::new().sorted_by_priority().is_empty());
+}
+
+#[test]
+fn priority_parses_all_labels_and_rejects_unknown() {
+    assert_eq!(Priority::parse("low"), Some(Priority::Low));
+    assert_eq!(Priority::parse("normal"), Some(Priority::Normal));
+    assert_eq!(Priority::parse("high"), Some(Priority::High));
+    assert_eq!(Priority::parse("urgent"), None);
+    assert_eq!(Priority::High.label(), "high");
+    assert_eq!(Priority::Normal.label(), "normal");
+    assert_eq!(Priority::Low.label(), "low");
+}
+
+#[test]
+fn report_ends_with_priority_summary_line() {
+    let mut s = Store::new();
+    s.add("a", vec![], Priority::High);
+    s.add("b", vec![], Priority::Normal);
+    s.add("c", vec![], Priority::Low);
+    s.add("d", vec![], Priority::High);
+    let all: Vec<_> = s.all().iter().collect();
+    let out = render(&all);
+    assert!(out.ends_with("high: 2 normal: 1 low: 1\n"), "got:\n{out}");
+}
+
+#[test]
+fn report_summary_of_empty_board_is_zero() {
+    let store = Store::new();
+    let all: Vec<_> = store.all().iter().collect();
+    assert_eq!(render(&all), "high: 0 normal: 0 low: 0\n");
+}
