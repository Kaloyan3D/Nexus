 /// A field may be wrapped in double quotes. Inside a quoted field a comma is part of the data and
 /// a doubled quote (`""`) stands for one literal quote. Unquoted fields are trimmed of surrounding spaces.
 pub fn parse_line(line: &str) -> Vec<String> {
-    line.split(',').map(|f| f.trim().to_string()).collect()
+    let mut fields = Vec::new();
+    let mut field = String::new();
+    let mut chars = line.chars().peekable();
+    let mut in_quotes = false;
+    // Tracks whether the current field started as a quoted field, so we
+    // don't trim significant spaces from quoted data. Unquoted fields are
+    // trimmed per the documented behaviour.
+    let mut field_is_quoted = false;
+    let mut field_has_content = false;
+    while let Some(c) = chars.next() {
+        if in_quotes {
+            if c == '"' {
+                if chars.peek() == Some(&'"') {
+                    field.push('"');
+                    chars.next();
+                } else {
+                    in_quotes = false;
+                }
+            } else {
+                field.push(c);
+            }
+        } else if c == '"' && !field_has_content {
+            in_quotes = true;
+            field_is_quoted = true;
+            field_has_content = true;
+        } else if c == ',' {
+            if field_is_quoted {
+                fields.push(field);
+            } else {
+                fields.push(field.trim().to_string());
+            }
+            field = String::new();
+            field_is_quoted = false;
+            field_has_content = false;
+        } else {
+            field.push(c);
+            if c != ' ' && c != '\t' {
+                field_has_content = true;
+            }
+        }
+    }
+    if field_is_quoted {
+        fields.push(field);
+    } else {
+        fields.push(field.trim().to_string());
+    }
+    fields
 }
