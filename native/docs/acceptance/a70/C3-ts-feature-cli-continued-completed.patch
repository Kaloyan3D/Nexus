+/**
+ * Removes the given query parameter(s) from the URL.
+ *
+ * Everything else (path, hash, remaining parameters, their order and their encoding) is left unchanged.
+ * If no parameters remain, the `?` is removed as well.
+ * Removing a key that is not present returns the input unchanged.
+ * Keys are compared after decoding, so an encoded key like `a%20b` matches `a b`.
+ *
+ * @example
+ *
+ * ```js
+ * withoutQuery("/foo?bar=1&baz=2", "bar"); // "/foo?baz=2"
+ * withoutQuery("/foo?bar=1&baz=2", ["bar", "baz"]); // "/foo"
+ * ```
+ *
+ * @group utils
+ */
+export function withoutQuery(input: string, keys: string | string[]): string {
+  const keysToRemove = new Set(
+    (Array.isArray(keys) ? keys : [keys]).map((key) => decodeQueryKey(key)),
+  );
+  if (keysToRemove.size === 0 || !input.includes("?")) {
+    return input;
+  }
+  const parsed = parseURL(input);
+  if (!parsed.search) {
+    return input;
+  }
+  const raw = parsed.search[0] === "?" ? parsed.search.slice(1) : parsed.search;
+  let removed = false;
+  const kept = raw.split("&").filter((parameter) => {
+    if (!parameter) {
+      return false;
+    }
+    const equalsIndex = parameter.indexOf("=");
+    const rawKey =
+      equalsIndex === -1 ? parameter : parameter.slice(0, equalsIndex);
+    if (keysToRemove.has(decodeQueryKey(rawKey))) {
+      removed = true;
+      return false;
+    }
+    return true;
+  });
+  // Key not present: return input untouched (preserves original formatting)
+  if (!removed) {
+    return input;
+  }
+  parsed.search = kept.join("&");
+  return stringifyParsedURL(parsed);
+}
